{
  "name": "web-api-performance-accessibility",
  "version": "0.1.0",
  "private": true,
  "description": "Performance tests with k6 and accessibility tests with Playwright + axe, for the web UI and the REST API of the Toolshop demo app.",
  "author": "Manimaran Murugan",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:a11y": "playwright test",
    "test:a11y:web": "playwright test --project=chromium --project=mobile",
    "test:a11y:api": "playwright test --project=api",
    "perf:api:smoke": "k6 run k6/api-smoke.ts",
    "perf:api:load": "k6 run k6/api-load.ts",
    "perf:api:stress": "k6 run k6/api-stress.ts",
    "perf:web": "k6 run k6/web-vitals.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/k6": "^2.3.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
