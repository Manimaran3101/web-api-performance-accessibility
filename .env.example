# Where the tests point. Defaults are the public demo.
BASE_URL=https://practicesoftwaretesting.com
API_URL=https://api.practicesoftwaretesting.com

# k6 load and stress tests refuse to run against the public demo unless this is set.
# Leave it unset: run load/stress only against your own copy of the app (CI does this).
# ALLOW_PUBLIC_LOAD=true

# k6 browser needs Chromium. Locally you can reuse Playwright's, for example:
# K6_BROWSER_EXECUTABLE_PATH=C:\Users\<you>\AppData\Local\ms-playwright\chromium-1248\chrome-win64\chrome.exe
